<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Favourites</title>

  <!-- Bootstrap CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Link to external CSS -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container main-container">
    <!-- Header -->
    <h1 class="text-center title">Favourites Page</h1>

    <!-- Top Buttons Layout -->
    <div class="top-buttons">
      <!-- Left Side Buttons -->
      <div class="left-buttons">
        <button class="btn btn-custom" onclick="window.location.href='/'">Main</button>
        <button id="cveBtn" class="search-btn btn btn-custom">CVE ID Search</button>
      </div>

      <!-- Center Buttons -->
      <div class="center-buttons">
        <button id="vendorBtn" class="search-btn btn btn-custom">Vendor Search</button>
        <button id="productBtn" class="search-btn btn btn-custom">Product Search</button>
      </div>

      <!-- Right Side Buttons -->
      <div class="right-buttons">
        <button class="btn btn-custom small"><%= username %></button>
        <form id="logout" action="/logout" method="get">
            <button type="submit" class="btn btn-custom small">Logout</button>
        </form>
        <form id="export" action="/export-cves" method="POST">
          <input type="hidden" name="selectedVulns" id="exportSelected">
          <button id="exportBtn" class="btn btn-custom small">Export</button>
        </form>
        <form id="remove" action="/remove-favourites" method="POST">
          <input type="hidden" name="selectedVulns" id="removeSelected">
          <button id="removeBtn" class="btn btn-custom small">Remove</button>
        </form>
      </div>
    </div>

    <!-- Favourites Table -->
    <div class="table-container">
      <table class="table" id="favouritesTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
            <th>Select</th>
          </tr>
        </thead>
        <tbody>
          <% if (favourites.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center">No favourites added.</td>
            </tr>
          <% } else { %>
            <% favourites.forEach(fav => { %>
              <tr>
                <td><a href='/cve/<%= fav.CVE_ID %>'><%= fav.CVE_ID %></a></td>
                <td><%= fav.Vendors %></td>
                <td><%= fav.Products %></td>
                <td><%= fav.BaseMetricV3.baseScore %></td>
                <td><%= fav.BaseMetricV3.baseSeverity %></td>
                <td><%= fav.ProblemType %></td>
                <td><input type="checkbox" class="vuln-checkbox" value="<%= fav._id %>"</td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Favourites</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-light">
  <div class="container mt-4">

    <!-- Header -->
    <h1 class="text-center mb-4">Favourites</h1>

    <!-- Top Buttons -->
    <div class="row mb-3">
      <div class="col-md-3 d-flex flex-column">
        <button class="btn btn-dark mb-2" onclick="window.location.href='/'">Main</button>
        <button id="cveSearchBtnFav" class="btn btn-primary" onclick="transformToInput('cveSearchBtnFav', 'cveSearchFav')">CVE ID Search</button>
      </div>

      <div class="col-md-6 d-flex justify-content-center gap-2">
        <button id="vendorSearchBtnFav" class="btn btn-primary" onclick="transformToInput('vendorSearchBtnFav', 'vendorSearchFav')">Vendor Search</button>
        <button id="productSearchBtnFav" class="btn btn-primary" onclick="transformToInput('productSearchBtnFav', 'productSearchFav')">Product Search</button>
      </div>

      <div class="col-md-3 d-flex justify-content-end gap-2">
        <button class="btn btn-outline-dark">Login</button>
        <button class="btn btn-outline-dark">Sign Up</button>
        <button class="btn btn-outline-dark">Save</button>
        <button class="btn btn-outline-danger">Remove</button>
      </div>
    </div>

    <!-- Favourites Table -->
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="favouritesTable">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (favourites.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center">No favourites added.</td>
            </tr>
          <% } else { %>
            <% favourites.forEach(fav => { %>
              <tr>
                <td><%= fav.id %></td>
                <td><%= fav.vendor %></td>
                <td><%= fav.product %></td>
                <td><%= fav.baseScore %></td>
                <td><%= fav.baseSeverity %></td>
                <td><%= fav.cwe %></td>
                <td>
                  <form action="/remove-favourite" method="POST">
                    <input type="hidden" name="cveId" value="<%= fav.id %>">
                    <button type="submit" class="btn btn-danger btn-sm">❌ Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
  <script src="/script.js"></script>
</body>
</html>

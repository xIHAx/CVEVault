<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Favourites</title>

  <!-- Bootstrap CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Link to external CSS -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container main-container">
    <!-- Header -->
    <h1 class="text-center title">Favourites Page</h1>

    <!-- Top Buttons Layout -->
    <div class="top-buttons">
      <!-- Left Side Buttons -->
      <div class="left-buttons">
        <button class="btn btn-custom" onclick="window.location.href='/'">Main</button>
        <button id="cveSearchBtn" class="search-btn btn btn-custom">CVE ID Search</button>
      </div>

      <!-- Center Buttons -->
      <div class="center-buttons">
        <button id="vendorSearchBtn" class="search-btn btn btn-custom">Vendor Search</button>
        <button id="productSearchBtn" class="search-btn btn btn-custom">Product Search</button>
      </div>

      <!-- Right Side Buttons -->
      <div class="right-buttons">
        <button class="btn btn-custom small" onclick="window.location.href='/login'">Login</button>
        <button class="btn btn-custom small" onclick="window.location.href='/signup'">Sign Up</button>
        <button class="btn btn-custom small">Save</button>
        <button class="btn btn-custom small btn-danger">Remove</button>
      </div>
    </div>

    <!-- Favourites Table -->
    <div class="table-container">
      <table class="table" id="favouritesTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (favourites.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center">No favourites added.</td>
            </tr>
          <% } else { %>
            <% favourites.forEach(fav => { %>
              <tr>
                <td><%= fav.id %></td>
                <td><%= fav.vendor %></td>
                <td><%= fav.product %></td>
                <td><%= fav.baseScore %></td>
                <td><%= fav.baseSeverity %></td>
                <td><%= fav.cwe %></td>
                <td>
                  <form action="/remove-favourite" method="POST" onsubmit="return confirm('Are you sure you want to remove this favourite?');">
                    <input type="hidden" name="cveId" value="<%= fav.id %>">
                    <button type="submit" class="btn btn-danger btn-sm">❌ Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>

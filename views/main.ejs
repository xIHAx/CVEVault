<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Main Page</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">

    <!-- Header -->
    <h1 class="title">Main Page</h1>

    <!-- Top Buttons -->
<div class="top-buttons">
    <div class="left-buttons">
      <button class="btn" onclick="window.location.href='/favourites'">Favourites</button>
      <button id="cveSearchBtn" class="btn" onclick="transformToInput('cveSearchBtn', 'cveSearch')">CVE ID Search</button>
    </div>
  
    <div class="center-buttons">
      <button id="vendorSearchBtn" class="btn" onclick="transformToInput('vendorSearchBtn', 'vendorSearch')">Vendor Search</button>
      <button id="productSearchBtn" class="btn" onclick="transformToInput('productSearchBtn', 'productSearch')">Product Search</button>
    </div>
  
    <div class="right-buttons">
      <button class="btn small">Login</button>
      <button class="btn small">Sign Up</button>
      <button class="btn small">Save</button>
      <button class="btn small">Favourite</button>
    </div>
  </div>
  
    <!-- CVE Table -->
    <div class="table-container">
      <table id="mainTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
          </tr>
        </thead>
        <tbody>
          <% vulnerabilities.forEach(vuln => { %>
            <tr>
              <td><%= vuln.id %></td>
              <td><%= vuln.vendor %></td>
              <td><%= vuln.product %></td>
              <td><%= vuln.baseScore %></td>
              <td><%= vuln.baseSeverity %></td>
              <td><%= vuln.cwe %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>
  <script src="/script.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Main Page</title>

  <!-- Bootstrap CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Link to external CSS -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container main-container">
    <!-- Header -->
    <h1 class="text-center title">Main Page</h1>

    <!-- Top Buttons Layout -->
    <div class="top-buttons">
      <!-- Left Side Buttons -->
      <div class="left-buttons">
        <button class="btn btn-custom" onclick="window.location.href='/favourites'">Favourites</button>
        <button id="cveSearchBtnFav" class="btn btn-custom" onclick="transformToInput('cveSearchBtnFav', 'cveSearchFav')">CVE ID Search</button>
      </div>

      <!-- Center Buttons -->
      <div class="center-buttons">
        <button id="vendorSearchBtnFav" class="btn btn-custom" onclick="transformToInput('vendorSearchBtnFav', 'vendorSearchFav')">Vendor Search</button>
        <button id="productSearchBtnFav" class="btn btn-custom" onclick="transformToInput('productSearchBtnFav', 'productSearchFav')">Product Search</button>
      </div>

      <!-- Right Side Buttons -->
      <div class="right-buttons">
        <button class="btn btn-custom small">Login</button>
        <button class="btn btn-custom small">Sign Up</button>
        <button class="btn btn-custom small">Save</button>
        <button class="btn btn-custom small">Favourite</button>
      </div>
    </div>

    <!-- CVE Table -->
    <div class="table-container">
      <table class="table" id="mainTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
          </tr>
        </thead>
        <tbody>
          <% vulnerabilities.forEach(vuln => { %>
            <tr>
              <td><%= vuln.id %></td>
              <td><%= vuln.vendor %></td>
              <td><%= vuln.product %></td>
              <td><%= vuln.baseScore %></td>
              <td><%= vuln.baseSeverity %></td>
              <td><%= vuln.cwe %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>

  <script src="/script.js"></script>
</body>
</html>

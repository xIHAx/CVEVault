<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Main Page</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-light">
  <div class="container mt-4">

    <!-- Header -->
    <h1 class="text-center mb-4">Main Page</h1>

    <!-- Top Buttons -->
    <div class="row mb-3">
      <div class="col-md-3 d-flex flex-column">
        <button class="btn btn-dark mb-2" onclick="window.location.href='/favourites'">Favourites</button>
        <button id="cveSearchBtn" class="btn btn-primary" onclick="transformToInput('cveSearchBtn', 'cveSearch')">CVE ID Search</button>
      </div>

      <div class="col-md-6 d-flex justify-content-center gap-2">
        <button id="vendorSearchBtn" class="btn btn-primary" onclick="transformToInput('vendorSearchBtn', 'vendorSearch')">Vendor Search</button>
        <button id="productSearchBtn" class="btn btn-primary" onclick="transformToInput('productSearchBtn', 'productSearch')">Product Search</button>
      </div>

      <div class="col-md-3 d-flex justify-content-end gap-2">
        <button class="btn btn-outline-dark">Login</button>
        <button class="btn btn-outline-dark">Sign Up</button>
        <button class="btn btn-outline-dark">Save</button>
        <button class="btn btn-outline-dark">Favourite</button>
      </div>
    </div>

    <!-- CVE Table -->
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="mainTable">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Vendor</th>
            <th>Product</th>
            <th>Base Score</th>
            <th>Base Severity</th>
            <th>CWE</th>
          </tr>
        </thead>
        <tbody>
          <% vulnerabilities.forEach(vuln => { %>
            <tr>
              <td><%= vuln.id %></td>
              <td><%= vuln.vendor %></td>
              <td><%= vuln.product %></td>
              <td><%= vuln.baseScore %></td>
              <td><%= vuln.baseSeverity %></td>
              <td><%= vuln.cwe %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>
  <script src="/script.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="d-flex align-items-center justify-content-center vh-100 bg-light">
    
    <a href="/" class="btn btn-custom back-to-main">⬅ Back to Main</a>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-4 shadow bg-custom">
                    <div class="card-body text-center">
                        <h2 class="fw-bold mb-4">Sign Up</h2>

                        <div class="row">
                            <!-- Sign Up Form -->
                            <div class="col-md-6">
                                <form action="/signup" method="POST">
                                    <!-- Username Input -->
                                    <div class="mb-3">
                                        <label for="username" class="form-label">Username</label>
                                        <input type="text" name="username" id="username" class="form-control input-custom" placeholder="Enter your username" autocomplete="username" required>
                                    </div>
                                    
                                    <!-- Password Input -->
                                    <div class="mb-3">
                                        <label for="password" class="form-label">Password</label>
                                        <input type="password" name="password" id="password" class="form-control input-custom" placeholder="Enter your password" autocomplete="new-password" required>
                                    </div>

                                    <!-- Repeat Password Input -->
                                    <div class="mb-3">
                                        <label for="confirmPassword" class="form-label">Repeat Password</label>
                                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control input-custom" placeholder="Repeat your password" required>
                                    </div>

                                    <!-- Email Input -->
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" name="email" id="email" class="form-control input-custom" placeholder="Enter your email" autocomplete="email" required>
                                    </div>

                                    <!-- Sign Up Button -->
                                    <button type="submit" class="btn btn-custom w-100">Sign up</button>
                                </form>
                            </div>

                            <!-- Password Complexity Box -->
                            <div class="col-md-5 mx-auto d-flex align-items-center">
                                <div class="password-box p-3 border border-dark rounded">
                                    <p class="fw-bold">Password Complexity</p>
                                    <ul class="list-unstyled">
                                        <li id="lengthCheck" class="text-danger">❌ At least 8 characters</li>
                                        <li id="uppercaseCheck" class="text-danger">❌ At least one uppercase letter</li>
                                        <li id="lowercaseCheck" class="text-danger">❌ At least one lowercase letter</li>
                                        <li id="numberCheck" class="text-danger">❌ At least one number</li>
                                        <li id="specialCharCheck" class="text-danger">❌ At least one special character</li>
                                    </ul>
                                    <div class="progress">
                                        <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Already Have an Account? -->
                        <div class="text-center mt-3">
                            <p>Already have an account? <a href="/login" class="text-dark fw-bold">Log in</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
</body>
</html>
